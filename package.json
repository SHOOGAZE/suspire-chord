{
  "name": "suspire",
  "version": "1.1.0",
  "description": "SUSPIRE: a chord instrument for your phone. Single-file HTML, no install.",
  "type": "module",
  "license": "MIT",
  "author": "Kirill Kinderhart",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SHOOGAZE/suspire-chord.git"
  },
  "scripts": {
    "build": "node build.mjs",
